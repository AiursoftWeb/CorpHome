<div class="container-fluid p-4">
    <h1 class="h3 mb-3">Aiursoft</h1>
    <p class="text-muted mb-4">@Localizer["Explore Aiursoft products, learn about the company, and contact our team."]</p>
    <div class="row g-3">
        <div class="col-12 col-lg-4">
            <div class="card h-100 mb-0">
                <div class="card-body">
                    <h2 class="h5 card-title"><a asp-controller="Home" asp-action="Index">@Localizer["Explore our products"]</a></h2>
                    <p class="card-text">@Localizer["Discover Aiursoft software and services."]</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100 mb-0">
                <div class="card-body">
                    <h2 class="h5 card-title"><a asp-controller="Home" asp-action="KnowUs">@Localizer["About Aiursoft"]</a></h2>
                    <p class="card-text">@Localizer["Learn about our team and how we work."]</p>
                </div>
            </div>
        </div>
        <div class="col-12 col-lg-4">
            <div class="card h-100 mb-0">
                <div class="card-body">
                    <h2 class="h5 card-title"><a asp-controller="Home" asp-action="Contact">@Localizer["Contact us"]</a></h2>
                    <p class="card-text">@Localizer["Talk to our team about your organization and requirements."]</p>
                </div>
            </div>
        </div>
    </div>
</div>
